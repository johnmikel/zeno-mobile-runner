{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zmr.dev/schemas/import-output.schema.json",
  "title": "ZMR Import Output",
  "type": "object",
  "additionalProperties": false,
  "required": ["ok", "format", "source", "out", "name", "appId", "stepCount", "next", "nextCommands"],
  "properties": {
    "ok": { "const": true },
    "format": { "enum": ["flow-yaml", "maestro"] },
    "source": { "type": "string", "minLength": 1 },
    "out": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "appId": { "type": ["string", "null"] },
    "stepCount": { "type": "integer", "minimum": 0 },
    "next": { "type": "string", "minLength": 1 },
    "nextCommands": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "native", "mode", "reviewRequired", "unsupportedCommandPolicy", "supportedCommands", "unsupportedFamilies", "notes"],
      "properties": {
        "source": { "const": "maestro-yaml" },
        "native": { "const": "zmr-json" },
        "mode": { "const": "smoke-subset" },
        "reviewRequired": { "const": true },
        "unsupportedCommandPolicy": { "const": "fail-fast" },
        "supportedCommands": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "unsupportedFamilies": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "notes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
