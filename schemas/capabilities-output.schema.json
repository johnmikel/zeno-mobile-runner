{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zmr.dev/schemas/capabilities-output.schema.json",
  "title": "ZMR Capabilities Output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "version",
    "protocolVersion",
    "protocol",
    "platforms",
    "platformSupport",
    "iosPreview",
    "transports",
    "methods",
    "actions"
  ],
  "properties": {
    "name": { "const": "zmr" },
    "version": { "type": "string", "minLength": 1 },
    "protocolVersion": { "type": "string", "minLength": 1 },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "minimumCompatibleVersion",
        "stability",
        "breakingChangePolicy"
      ],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "minimumCompatibleVersion": { "type": "string", "minLength": 1 },
        "stability": { "type": "string", "minLength": 1 },
        "breakingChangePolicy": { "type": "string", "minLength": 1 }
      }
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["android", "ios"] },
      "uniqueItems": true
    },
    "platformSupport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["android", "ios"],
      "properties": {
        "android": { "$ref": "#/$defs/platformSupport" },
        "ios": {
          "allOf": [{ "$ref": "#/$defs/platformSupport" }],
          "required": ["status", "deviceTypes", "automation", "physicalDevices"],
          "properties": {
            "physicalDevices": { "const": true }
          }
        }
      }
    },
    "iosPreview": { "const": false },
    "transports": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["stdio", "tcp"] },
      "uniqueItems": true
    },
    "methods": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/action" }
    }
  },
  "$defs": {
    "platformSupport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "deviceTypes", "automation"],
      "properties": {
        "status": { "enum": ["supported", "preview", "unsupported"] },
        "deviceTypes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": ["emulator", "physical", "simulator"]
          },
          "uniqueItems": true
        },
        "automation": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "physicalDevices": { "type": "boolean" }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "jsonAliases",
        "yamlAliases",
        "rpcAliases",
        "mcpAliases",
        "parameterSchema",
        "platforms",
        "requiredCapability",
        "mutability",
        "riskClass",
        "traceEvent",
        "version",
        "deprecated",
        "replacement"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "jsonAliases": { "$ref": "#/$defs/aliases" },
        "yamlAliases": { "$ref": "#/$defs/aliases" },
        "rpcAliases": { "$ref": "#/$defs/aliases" },
        "mcpAliases": { "$ref": "#/$defs/aliases" },
        "parameterSchema": { "type": "string", "minLength": 1 },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["android", "ios"] },
          "uniqueItems": true
        },
        "requiredCapability": { "type": "string", "minLength": 1 },
        "mutability": { "enum": ["read_only", "mutating", "lifecycle", "control"] },
        "riskClass": { "enum": ["low", "medium", "high"] },
        "traceEvent": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "deprecated": { "type": "boolean" },
        "replacement": { "type": ["string", "null"] }
      }
    },
    "aliases": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  }
}
